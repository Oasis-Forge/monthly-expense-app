    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلتقط الكاميرا صورة للإيصال لحفظها مع المعاملة. تبقى الصور على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্যামেরা দিয়ে রসিদের ছবি তুলে লেনদেনের সঙ্গে রাখা হয়। ছবিগুলো এই ডিভাইসেই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Kamera fotografierst du einen Beleg, der bei der Buchung bleibt. Fotos bleiben auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα τραβά φωτογραφία της απόδειξης για να τη φυλάξετε μαζί με μια συναλλαγή. Οι φωτογραφίες παραμένουν σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera takes a photo of a receipt to keep with a transaction. Photos stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara hace una foto del recibo para guardarla con la transacción. Las fotos se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo prend une photo du reçu à conserver avec la transaction. Les photos restent sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा रसीद की फोटो खींचता है ताकि उसे लेनदेन के साथ रखा जा सके। फोटो इसी डिवाइस पर रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera mengambil foto struk untuk disimpan bersama transaksi. Foto tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera scatta una foto dello scontrino da conservare con la transazione. Le foto restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラでレシートを撮影し、取引と一緒に保存します。写真はこの端末だけに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라로 영수증 사진을 찍어 거래와 함께 보관합니다. 사진은 이 기기에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de camera maak je een foto van de bon om bij een transactie te bewaren. Foto’s blijven op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat robi zdjęcie paragonu, które zostaje przy transakcji. Zdjęcia zostają na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera tira uma foto do recibo para guardar com a transação. As fotos ficam neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера снимает чек, чтобы сохранить его вместе с операцией. Фото хранятся только на этом устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้องใช้ถ่ายรูปใบเสร็จเพื่อเก็บไว้กับรายการ รูปภาพจะถูกเก็บไว้ในอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera, bir işlemle birlikte saklamak için fişin fotoğrafını çeker. Fotoğraflar bu cihazda kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیمرا رسید کی تصویر لیتا ہے تاکہ اسے ٹرانزیکشن کے ساتھ رکھا جا سکے۔ تصاویر اسی ڈیوائس پر رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảnh chụp hóa đơn để lưu kèm giao dịch. Ảnh chỉ lưu trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机用于拍摄小票照片，与交易一起保存。照片仅保存在本设备上。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Face ID قفل Monthly Expenses عندما يكون قفل التطبيق مفعّلًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ লক চালু থাকলে Face ID দিয়ে Monthly Expenses আনলক হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID entsperrt Monthly Expenses, wenn die App-Sperre an ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Face ID ξεκλειδώνει το Monthly Expenses όταν είναι ενεργό το κλείδωμα εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID unlocks Monthly Expenses when app lock is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID desbloquea Monthly Expenses cuando el bloqueo de la app está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID déverrouille Monthly Expenses lorsque le verrouillage de l’app est activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप लॉक चालू होने पर Face ID से Monthly Expenses अनलॉक होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID membuka kunci Monthly Expenses saat kunci aplikasi aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID sblocca Monthly Expenses quando il blocco app è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリロックがオンのとき、Face ID で Monthly Expenses のロックを解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 잠금이 켜져 있으면 Face ID로 Monthly Expenses의 잠금을 해제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ontgrendelt Monthly Expenses als app-vergrendeling aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID odblokowuje Monthly Expenses, gdy blokada aplikacji jest włączona."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID desbloqueia o Monthly Expenses quando o bloqueio do app está ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID разблокирует Monthly Expenses, когда включена блокировка приложения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ใช้ปลดล็อก Monthly Expenses เมื่อเปิดล็อกแอปไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kilidi açıkken Face ID, Monthly Expenses’ın kilidini açar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ لاک آن ہو تو Face ID سے Monthly Expenses ان لاک ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID mở khóa Monthly Expenses khi khóa ứng dụng đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启应用锁后，使用面容 ID 解锁 Monthly Expenses。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل الميكروفون ملاحظة صوتية لحفظها مع المعاملة. تبقى التسجيلات على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাইক্রোফোন দিয়ে ভয়েস নোট রেকর্ড করে লেনদেনের সঙ্গে রাখা হয়। রেকর্ডিংগুলো এই ডিভাইসেই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Mikrofon nimmst du eine Sprachnotiz auf, die bei der Buchung bleibt. Aufnahmen bleiben auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μικρόφωνο ηχογραφεί μια φωνητική σημείωση για να τη φυλάξετε μαζί με μια συναλλαγή. Οι ηχογραφήσεις παραμένουν σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone records a voice note to keep with a transaction. Recordings stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono graba una nota de voz para guardarla con la transacción. Las grabaciones se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro enregistre une note vocale à conserver avec la transaction. Les enregistrements restent sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन वॉइस नोट रिकॉर्ड करता है ताकि उसे लेनदेन के साथ रखा जा सके। रिकॉर्डिंग इसी डिवाइस पर रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon merekam catatan suara untuk disimpan bersama transaksi. Rekaman tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono registra una nota vocale da conservare con la transazione. Le registrazioni restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクで音声メモを録音し、取引と一緒に保存します。録音はこの端末だけに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크로 음성 메모를 녹음해 거래와 함께 보관합니다. 녹음은 이 기기에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de microfoon neem je een spraaknotitie op om bij een transactie te bewaren. Opnames blijven op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon nagrywa notatkę głosową, która zostaje przy transakcji. Nagrania zostają na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone grava uma nota de voz para guardar com a transação. As gravações ficam neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон записывает голосовую заметку, чтобы сохранить её вместе с операцией. Записи хранятся только на этом устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไมโครโฟนใช้บันทึกเสียงเพื่อเก็บไว้กับรายการ ไฟล์เสียงจะถูกเก็บไว้ในอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon, bir işlemle birlikte saklamak için sesli not kaydeder. Kayıtlar bu cihazda kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مائیکروفون صوتی نوٹ ریکارڈ کرتا ہے تاکہ اسے ٹرانزیکشن کے ساتھ رکھا جا سکے۔ ریکارڈنگز اسی ڈیوائس پر رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micrô ghi âm để lưu kèm giao dịch. Bản ghi âm chỉ lưu trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风用于录制语音备注，与交易一起保存。录音仅保存在本设备上。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اختيار صورة تُرفق نسخة منها بالمعاملة. تبقى النسخة على هذا الجهاز."
          }
        },
