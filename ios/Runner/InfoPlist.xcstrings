    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بذلك يتيح اختيار الإعلانات التي تموّل Monthly Expenses بما يناسبك. لا تتم مشاركة معاملاتك أبدًا، أيًّا كان اختيارك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুমতি দিলে Monthly Expenses-এর খরচ জোগানো বিজ্ঞাপনগুলো আপনার জন্য বেছে নেওয়া হয়। আপনি যা-ই বেছে নিন, আপনার লেনদেন কখনো শেয়ার করা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das erlaubst, wird die Werbung, die Monthly Expenses finanziert, für dich ausgewählt. Deine Buchungen werden nie weitergegeben, egal wie du dich entscheidest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το επιτρέψετε, οι διαφημίσεις που χρηματοδοτούν το Monthly Expenses θα επιλέγονται για εσάς. Οι συναλλαγές σας δεν κοινοποιούνται ποτέ, ό,τι κι αν επιλέξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allowing this lets the ads that pay for Monthly Expenses be chosen for you. Your transactions are never shared, whichever you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo permites, los anuncios que financian Monthly Expenses se elegirán para ti. Tus transacciones nunca se comparten, elijas lo que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous l’autorisez, les publicités qui financent Monthly Expenses seront choisies pour vous. Vos transactions ne sont jamais partagées, quel que soit votre choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी अनुमति देने पर Monthly Expenses का खर्च चलाने वाले विज्ञापन आपके लिए चुने जाते हैं। आप जो भी चुनें, आपके लेनदेन कभी साझा नहीं किए जाते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diizinkan, iklan yang membiayai Monthly Expenses akan dipilih sesuai dengan Anda. Transaksi Anda tidak pernah dibagikan, apa pun pilihan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo consenti, gli annunci che finanziano Monthly Expenses verranno scelti per te. Le tue transazioni non vengono mai condivise, qualunque cosa tu scelga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、Monthly Expenses を支える広告があなたに合わせて選ばれます。どちらを選んでも、取引が共有されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하면 Monthly Expenses 운영을 돕는 광고가 사용자에게 맞춰 선택됩니다. 무엇을 선택하든 거래 내역은 절대 공유되지 않습니다."
