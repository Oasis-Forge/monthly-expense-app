        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit toestaat, worden de advertenties die Monthly Expenses bekostigen voor jou gekozen. Je transacties worden nooit gedeeld, wat je ook kiest."
