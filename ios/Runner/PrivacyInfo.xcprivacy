<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's privacy manifest: what the Swift in ios/Runner does, and what
     any code bundled into the app without a manifest of its own does.
     Flutter, most plugins and the Google Mobile Ads SDK ship their own, and
     Xcode puts them all together in the app's privacy report. Some do not:
     the audioplayers_darwin and printing plugins, the google_mobile_ads
     plugin's own code (the SDK under it has one), and the libraries the
     sqlite3 and objective_c build hooks bundle. Any required-reason API
     those call has to be declared here, as SQLite's is below. -->
<plist version="1.0">
<dict>
	<!-- The app's own code tracks no one. What the ad SDK does is in the
	     SDK's own manifest (ADS-6). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nothing the app collects leaves the device: the records go only into
	     an export or a backup the user makes (BAK-6, ADS-7). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- HomeWidgetBridge.swift removes the widget payload that 1.31.1
		     and earlier kept in the App Group's UserDefaults suite, which
		     only this app and its widget share, now that the payload is a
		     file kept out of backups (WID-5, BAK-8): 1C8F.1. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
		<!-- Not our Swift: the SQLite library that the sqlite3 package's build
		     hook downloads and bundles into the app (it comes with
		     sqflite_common_ffi, and ships no manifest of its own). Its file
		     layer calls stat, fstat and lstat on the database files, which
		     live in the app's container: C617.1. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
