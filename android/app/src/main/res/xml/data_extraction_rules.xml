<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing recorded in this app is copied to Google's servers (BAK-8). Android
  would otherwise back the database and the settings up to the user's Drive on
  its own, which is a copy of every entry that nobody asked for; the records
  leave the phone through an export or a backup the user asked for, and no
  other way (BAK-6).

  On Android 12 and up, moving to a new phone still carries them: that is the
  user taking their own data with them, not a copy left somewhere, so device
  transfer is left as it is there and only cloud backup is refused. On
  Android 11 and below, allowBackup="false" also turns off device transfer,
  so a phone-to-phone move does not carry them on those phones; a backup file
  the app makes when asked is the way to bring them along.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
