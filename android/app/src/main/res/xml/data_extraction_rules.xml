<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing recorded in this app is copied to Google's servers (BAK-8). Android
  would otherwise back the database and the settings up to the user's Drive on
  its own, which is a copy of every entry that nobody asked for; the records
  leave the phone through an export or a backup the user asked for, and no
  other way (BAK-6).

  Moving to a new phone still carries them: that is the user taking their own
  data with them, not a copy left somewhere. Device transfer is therefore left
  as it is, and only cloud backup is refused.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
