<?xml version="1.0" encoding="utf-8"?>
<!-- The 2x2 widget (WID-1). Every string is set from the app, so nothing
     here is translated: the widget follows the app's language, not the
     device's (WID-6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_period"
        android:text="@string/widget_preview_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:maxLines="1"
        android:textColor="@color/widget_label"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_amounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_main_label"
            android:text="@string/widget_preview_expense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:textColor="@color/widget_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_main_amount"
            android:text="@string/widget_preview_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:maxLines="1"
            android:textColor="@color/widget_amount"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hidden_note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:textColor="@color/widget_label"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_add_expense"
        android:text="@string/widget_preview_add_expense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_button"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:textColor="@color/widget_on_button"
        android:textSize="13sp" />
</LinearLayout>
