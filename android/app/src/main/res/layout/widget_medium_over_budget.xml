<?xml version="1.0" encoding="utf-8"?>
<!-- Same as widget_medium.xml except the budget-left amount's colour is the
     over-budget red, set here in XML rather than by a resolved int sent
     from the app. A different layout resource forces the launcher to
     re-inflate this file (and therefore re-resolve @color/widget_over_budget
     against its own light/dark configuration) on every theme change, on API
     levels below the setColorStateList(int, String, int) resource-id
     overload (API 31+, used instead on those) (WID-6, A11Y-3, THEME-4). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_period"
        android:text="@string/widget_preview_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:maxLines="1"
        android:textColor="@color/widget_label"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_amounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_income_label"
                android:text="@string/widget_preview_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_income_amount"
                android:text="@string/widget_preview_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_amount"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_expense_label"
                android:text="@string/widget_preview_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_expense_amount"
                android:text="@string/widget_preview_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_amount"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_balance_label"
                android:text="@string/widget_preview_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_balance_amount"
                android:text="@string/widget_preview_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_amount"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_budget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_budget_label"
                android:text="@string/widget_preview_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_budget_amount"
                android:text="@string/widget_preview_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:textColor="@color/widget_over_budget"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hidden_note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/widget_label"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_add_expense"
            android:text="@string/widget_preview_add_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:textColor="@color/widget_on_button"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_add_income"
            android:text="@string/widget_preview_add_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_button_outlined"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:textColor="@color/widget_accent"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
