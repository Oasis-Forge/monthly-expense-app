<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own colours. A launcher inflates its layout with the
     system's light or dark configuration, so the -night variants below are
     what makes the widget follow the device theme (WID-6). -->
<resources>
    <color name="widget_background">#FFFFFFFF</color>
    <color name="widget_label">#FF5F5F6B</color>
    <color name="widget_amount">#FF1B1B1F</color>
    <!-- The app's own expense ink (expenseInkLight, lib/models/money.dart),
         so an over-budget amount reads the same red as the rest of the app
         and clears 4.5:1 here too (CUR-5, A11Y-3, THEME-4). -->
    <color name="widget_over_budget">#FFB3261E</color>
    <color name="widget_accent">#FF6C5CE7</color>
    <color name="widget_on_button">#FFFFFFFF</color>
    <color name="widget_outline">#FFCFCBE3</color>
</resources>
